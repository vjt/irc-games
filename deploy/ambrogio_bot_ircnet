#!/bin/sh
# PROVIDE: ambrogio_bot_ircnet
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Ambrogio su Azzurra. Bot aggregatore dei sidecar di gioco/stat nella jail di
# Convento — ordine di vjt (#sbiffo 2026-09-10 22:31): «chanstats e il resto
# possono stare nello stesso bot che si chiama magari Ambrogio». vhost
# ci.pensa.ambrogio.con.la.grappa.chat (22:36), nick verificato non SQLINEato.
#
# IRC_BIND: su Azzurra il vhost e l rDNS dell indirizzo da cui esci, quindi
# ogni bot della jail vuole il suo. fffc::abbe ha il PTR
# ci.pensa.ambrogio.con.la.grappa.chat (AAAA zona grappa.chat su Cloudflare,
# PTR via netcup rdns ipv6 set).
#
# Log e FIFO suoi: i sidecar taillano il suo log e scrivono sulla sua FIFO.
. /etc/rc.subr
name="ambrogio_bot_ircnet"
rcvar="ambrogio_bot_ircnet_enable"
load_rc_config "$name"
: ${ambrogio_bot_ircnet_enable:="NO"}
pidfile="/var/run/convento/ambrogio.ircnet.pid"
procname="/usr/local/bin/python3.11"
command="/usr/sbin/daemon"
daemon_pidfile="${pidfile%.pid}.daemon.pid"
command_args="-f -R 5 -P ${daemon_pidfile} -p ${pidfile} -u convento -o /var/log/convento/ambrogio.ircnet.stdout.log -t ambrogio-ircnet \
  /usr/bin/env IRC_BIND=2a03:4000:20:2d3:fffc::abbe IRC_HOST=irc.ircnet.com IRC_TLS_VERIFY=0 \
  IRC_NICK=Ambrogio IRC_IDENT=ambrogio IRC_REAL='Ambrogio, avverto un certo languorino' \
  BOT_LOG=/var/log/convento/ambrogio.ircnet.log BOT_FIFO=/var/run/convento/ambrogio.ircnet.send \
  BOT_TRUST=/opt/convento/bot.trust.ambrogio BOT_ENV=/opt/convento/.env.convento \
  BOT_STARTUP=/opt/convento/bot.startup.ambrogio.ircnet \
  /usr/local/bin/python3.11 -u /opt/convento/bot.py"
# daemon(8) fa da supervisore e rc.subr insegue il FIGLIO (procname), quindi uno
# stop che trova il python gia' morto lascia vivo il supervisore col suo pidfile:
# lo start dopo muore con «process already running» e il sidecar resta giu' in
# silenzio (visto su convento_suore, 2026-09-11 23:33). -P da' al supervisore un
# pidfile suo, e l'hook qui sotto lo miete sia dopo stop che prima di start.
start_precmd="convento_reap_supervisor"
stop_postcmd="convento_reap_supervisor"
convento_reap_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	rm -f "${daemon_pidfile}"; return 0 ;;
	esac
	if kill -0 "${_dpid}" 2>/dev/null; then
		# figlio vivo = supervisore sano: giu' le mani, ci pensa rc.subr a
		# dire «already running».
		if [ -r "${pidfile}" ] && kill -0 "$(cat ${pidfile} 2>/dev/null)" 2>/dev/null; then
			return 0
		fi
		kill -TERM "${_dpid}" 2>/dev/null
		sleep 1
		kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	fi
	rm -f "${daemon_pidfile}" "${pidfile}"
}

# Con -R il supervisore rigenera il figlio dopo 5s, quindi uno stop che
# ammazza solo il python non ferma niente: il supervisore muore PRIMA
# (daemon(8) inoltra il TERM al figlio e se ne va), e rc.subr trova il
# campo gia sgombro. Ordine di vjt 2026-09-19: "rendilo resilient convento".
stop_precmd="convento_kill_supervisor"
convento_kill_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	return 0 ;;
	esac
	kill -TERM "${_dpid}" 2>/dev/null
	sleep 2
	kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	return 0
}

run_rc_command "$1"
