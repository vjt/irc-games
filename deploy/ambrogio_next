#!/bin/sh
# PROVIDE: ambrogio_next
# REQUIRE: ambrogio_bot
# KEYWORD: shutdown
#
# Il ballottaggio "cosa facciamo dopo la 1.3" (#grappa, #sniffo) dietro ad
# Ambrogio. Migrato dal servizio systemd --user sul Pi il 2026-09-10 per
# ordine di vjt. Il JSON resta in /var/db/convento: lo aliasa l'nginx
# dell'host, il jail non scrive nel docroot Syncthing.
. /etc/rc.subr
name="ambrogio_next"
rcvar="ambrogio_next_enable"
load_rc_config "$name"
: ${ambrogio_next_enable:="NO"}
pidfile="/var/run/convento/next.pid"
procname="/usr/local/bin/python3.11"
command="/usr/sbin/daemon"
daemon_pidfile="${pidfile%.pid}.daemon.pid"
command_args="-f -R 5 -P ${daemon_pidfile} -p ${pidfile} -u convento -o /var/log/convento/next.log -t ambrogio-next \
  /usr/bin/env NEXT_LOG=/var/log/convento/ambrogio.log,/var/log/convento/ambrogio.ircnet.log \
  NEXT_FIFO=/var/run/convento/ambrogio.send,/var/run/convento/ambrogio.ircnet.send \
  NEXT_STATE=/var/db/convento/next_state.json \
  NEXT_OUT=/var/db/convento/next.json \
  /usr/local/bin/python3.11 -u /opt/irc-games/next_counter.py"
# daemon(8) fa da supervisore e rc.subr insegue il FIGLIO (procname), quindi uno
# stop che trova il python gia' morto lascia vivo il supervisore col suo pidfile:
# lo start dopo muore con «process already running» e il sidecar resta giu' in
# silenzio (visto su convento_suore, 2026-09-11 23:33). -P da' al supervisore un
# pidfile suo, e l'hook qui sotto lo miete sia dopo stop che prima di start.
start_precmd="convento_reap_supervisor"
stop_postcmd="convento_reap_supervisor"
convento_reap_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	rm -f "${daemon_pidfile}"; return 0 ;;
	esac
	if kill -0 "${_dpid}" 2>/dev/null; then
		# figlio vivo = supervisore sano: giu' le mani, ci pensa rc.subr a
		# dire «already running».
		if [ -r "${pidfile}" ] && kill -0 "$(cat ${pidfile} 2>/dev/null)" 2>/dev/null; then
			return 0
		fi
		kill -TERM "${_dpid}" 2>/dev/null
		sleep 1
		kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	fi
	rm -f "${daemon_pidfile}" "${pidfile}"
}

# Con -R il supervisore rigenera il figlio dopo 5s, quindi uno stop che
# ammazza solo il python non ferma niente: il supervisore muore PRIMA
# (daemon(8) inoltra il TERM al figlio e se ne va), e rc.subr trova il
# campo gia sgombro. Ordine di vjt 2026-09-19: "rendilo resilient convento".
stop_precmd="convento_kill_supervisor"
convento_kill_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	return 0 ;;
	esac
	kill -TERM "${_dpid}" 2>/dev/null
	sleep 2
	kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	return 0
}

run_rc_command "$1"
