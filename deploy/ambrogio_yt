#!/bin/sh
# PROVIDE: ambrogio_yt
# REQUIRE: ambrogio_bot
# KEYWORD: shutdown
#
# La riga YouTube del vecchio TOOLS dietro ad Ambrogio (vjt, #sbiffo
# 2026-09-13 11:47). Nessuno stato su disco e nessun file pubblico: legge il
# log, chiede la pagina a YouTube, scrive una riga nella FIFO.
. /etc/rc.subr
name="ambrogio_yt"
rcvar="ambrogio_yt_enable"
load_rc_config "$name"
: ${ambrogio_yt_enable:="NO"}
: ${ambrogio_yt_chans:="#sniffo,#sbiffo"}
pidfile="/var/run/convento/yt.pid"
procname="/usr/local/bin/python3.11"
command="/usr/sbin/daemon"
daemon_pidfile="${pidfile%.pid}.daemon.pid"
command_args="-f -P ${daemon_pidfile} -p ${pidfile} -u convento -o /var/log/convento/yt.log -t ambrogio-yt \
  /usr/bin/env YT_LOG=/var/log/convento/ambrogio.log \
  YT_FIFO=/var/run/convento/ambrogio.send \
  YT_CHANS=${ambrogio_yt_chans} \
  /usr/local/bin/python3.11 -u /opt/irc-games/yt_preview.py"
# Stesso mietitore degli altri sidecar: daemon(8) fa da supervisore e rc.subr
# insegue il FIGLIO (procname), quindi uno stop che trova il python gia' morto
# lascia vivo il supervisore col suo pidfile e lo start dopo muore con
# «process already running». Vedi ambrogio_next per la storia (2026-09-11).
start_precmd="convento_reap_supervisor"
stop_postcmd="convento_reap_supervisor"
convento_reap_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	rm -f "${daemon_pidfile}"; return 0 ;;
	esac
	if kill -0 "${_dpid}" 2>/dev/null; then
		if [ -r "${pidfile}" ] && kill -0 "$(cat ${pidfile} 2>/dev/null)" 2>/dev/null; then
			return 0
		fi
		kill -TERM "${_dpid}" 2>/dev/null
		sleep 1
		kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	fi
	rm -f "${daemon_pidfile}" "${pidfile}"
}

run_rc_command "$1"
