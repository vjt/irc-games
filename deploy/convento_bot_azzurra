#!/bin/sh
# PROVIDE: convento_bot_azzurra
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Convento su Azzurra. Seconda istanza dello stesso bot.py, stesso nick e
# stesso indirizzo (quindi stesso vhost) di quella IRCnet, altra rete.
# Ordine di vjt, #sbiffo 2026-09-09 23:34: «connettilo pure qui su azzurra
# sniffo e sbiffo / con lo stesso vhost».
#
# Log e FIFO sono SUOI, non quelli di IRCnet: il gioco tailla un log per rete e
# risponde sulla FIFO da cui e' arrivato il colpo. Condividerli vorrebbe dire
# rispondere su #cybernet a un .bang di #sniffo.
#
# TLS verify resta acceso (il default): Azzurra presenta una catena che valida,
# al contrario di IRCnet. Nessun NickServ — .env.azzurra e' vuoto, il nick non
# e' registrato e il vhost e' l'rDNS dell'indirizzo della jail.
. /etc/rc.subr
name="convento_bot_azzurra"
rcvar="convento_bot_azzurra_enable"
load_rc_config "$name"
: ${convento_bot_azzurra_enable:="NO"}
pidfile="/var/run/convento/bot.azzurra.pid"
# Il pidfile di daemon(8) tiene il pid del FIGLIO, non del supervisore, quindi
# rc.subr deve cercare l'interprete e non /usr/sbin/daemon: senza questo
# `service ... status` dice «is not running» mentre il bot gira, e `stop` non
# ammazza niente.
procname="/usr/local/bin/python3.11"
command="/usr/sbin/daemon"
daemon_pidfile="${pidfile%.pid}.daemon.pid"
command_args="-f -P ${daemon_pidfile} -p ${pidfile} -u convento -o /var/log/convento/bot.azzurra.stdout.log -t convento-azzurra \
  /usr/bin/env IRC_HOST=irc.azzurra.chat IRC_NICK=Convento \
  IRC_IDENT=convento IRC_REAL=github.com/vjt/irc-games \
  BOT_LOG=/var/log/convento/bot.azzurra.log BOT_FIFO=/var/run/convento/bot.azzurra.send \
  BOT_TRUST=/opt/convento/bot.trust.azzurra BOT_ENV=/opt/convento/.env.azzurra \
  BOT_STARTUP=/opt/convento/bot.startup.azzurra \
  /usr/local/bin/python3.11 -u /opt/convento/bot.py"
# daemon(8) fa da supervisore e rc.subr insegue il FIGLIO (procname), quindi uno
# stop che trova il python gia' morto lascia vivo il supervisore col suo pidfile:
# lo start dopo muore con «process already running» e il sidecar resta giu' in
# silenzio (visto su convento_suore, 2026-09-11 23:33). -P da' al supervisore un
# pidfile suo, e l'hook qui sotto lo miete sia dopo stop che prima di start.
start_precmd="convento_reap_supervisor"
stop_postcmd="convento_reap_supervisor"
convento_reap_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	rm -f "${daemon_pidfile}"; return 0 ;;
	esac
	if kill -0 "${_dpid}" 2>/dev/null; then
		# figlio vivo = supervisore sano: giu' le mani, ci pensa rc.subr a
		# dire «already running».
		if [ -r "${pidfile}" ] && kill -0 "$(cat ${pidfile} 2>/dev/null)" 2>/dev/null; then
			return 0
		fi
		kill -TERM "${_dpid}" 2>/dev/null
		sleep 1
		kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	fi
	rm -f "${daemon_pidfile}" "${pidfile}"
}

run_rc_command "$1"
