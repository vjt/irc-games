#!/bin/sh
# PROVIDE: convento_suore
# REQUIRE: convento_bot convento_bot_azzurra
# KEYWORD: shutdown
#
# Caccia alle suore, UN processo per DUE reti e TRE canali. Prima era un
# processo per canale: la suora, il timer e la cadenza erano globali di
# processo, e spawn() pescava sempre il primo canale in ordine alfabetico.
# Ordine di vjt, #sbiffo 2026-09-09 23:34: «rendilo multi rete e multi canale».
#
# SUORE_NETS: nome|log|fifo|#canale:min-max,... — i record separati da ';'.
# Log e FIFO stanno nello stesso record apposta: sono le due meta' dello stesso
# bot, e tenerle in due variabili separate era il modo facile di leggere i colpi
# di una rete e rispondere su un'altra.
#
# Cadenze: #sniffo 90-240 e #sbiffo 60-180 come le ha fissate vjt il 6/9
# (#sbiffo e' la testnet, li' si gioca di piu'); #cybernet 90-240, canale di
# passaggio.
#
# SUORE_NET=ircnet: e' la rete a cui viene attribuito uno stato salvato nel
# formato vecchio, che teneva i canali nudi. Lo stato di questa jail nasce li'.
#
# Il valore di SUORE_NETS va fra virgolette singole: rc.subr fa eval di
# command_args, e senza quelle la '|' del formato diventa una pipe di shell e
# la '#' dei canali apre un commento. Provato: senza apici il servizio parte
# e muore subito.
. /etc/rc.subr
name="convento_suore"
rcvar="convento_suore_enable"
load_rc_config "$name"
: ${convento_suore_enable:="NO"}
pidfile="/var/run/convento/suore.pid"
# Vedi convento_bot_azzurra: daemon(8) scrive il pid del figlio, quindi rc.subr
# deve cercare l'interprete o `status` e `stop` mentono.
procname="/usr/local/bin/python3.11"
command="/usr/sbin/daemon"
daemon_pidfile="${pidfile%.pid}.daemon.pid"
command_args="-f -R 5 -P ${daemon_pidfile} -p ${pidfile} -u convento -o /var/log/convento/suore.log -t convento-suore \
  /usr/bin/env SUORE_HOME=/var/db/convento SUORE_NET=ircnet \
  SUORE_STATE=/var/db/convento/suore_state.json \
  'SUORE_NETS=ircnet|/var/log/convento/bot.log|/var/run/convento/bot.send|#cybernet:90-240;azzurra|/var/log/convento/bot.azzurra.log|/var/run/convento/bot.azzurra.send|#sniffo:90-240,#sbiffo:60-180,#porcodio:50-70,#altrove:90-240' \
  /usr/local/bin/python3.11 -u /opt/irc-games/suore.py"
# daemon(8) fa da supervisore e rc.subr insegue il FIGLIO (procname), quindi uno
# stop che trova il python gia' morto lascia vivo il supervisore col suo pidfile:
# lo start dopo muore con «process already running» e il sidecar resta giu' in
# silenzio (visto su convento_suore, 2026-09-11 23:33). -P da' al supervisore un
# pidfile suo, e l'hook qui sotto lo miete sia dopo stop che prima di start.
start_precmd="convento_reap_supervisor"
stop_postcmd="convento_reap_supervisor"
convento_reap_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	rm -f "${daemon_pidfile}"; return 0 ;;
	esac
	if kill -0 "${_dpid}" 2>/dev/null; then
		# figlio vivo = supervisore sano: giu' le mani, ci pensa rc.subr a
		# dire «already running».
		if [ -r "${pidfile}" ] && kill -0 "$(cat ${pidfile} 2>/dev/null)" 2>/dev/null; then
			return 0
		fi
		kill -TERM "${_dpid}" 2>/dev/null
		sleep 1
		kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	fi
	rm -f "${daemon_pidfile}" "${pidfile}"
}

# Con -R il supervisore rigenera il figlio dopo 5s, quindi uno stop che
# ammazza solo il python non ferma niente: il supervisore muore PRIMA
# (daemon(8) inoltra il TERM al figlio e se ne va), e rc.subr trova il
# campo gia sgombro. Ordine di vjt 2026-09-19: "rendilo resilient convento".
stop_precmd="convento_kill_supervisor"
convento_kill_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	return 0 ;;
	esac
	kill -TERM "${_dpid}" 2>/dev/null
	sleep 2
	kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	return 0
}

run_rc_command "$1"
