#!/bin/sh
# PROVIDE: disagio_api
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Il backend di disagio.sniffo.org (vjt/irc-games#10): le frasi di !disagio in
# sqlite, i voti alla cieca sulle candidate, l'SSE come /mannaggia di
# cristobot. Solo stdlib. Ascolta sull'IP della jail: nginx sull'host fa da
# proxy per /api/{candidate,voto,classifica,frase,stream,health}, i JSON
# statici di build.py restano file.
# Il db si popola a mano, da utente convento (un -wal di root e' un db che il
# demone non scrive piu'):
#   su -m convento -c 'env DISAGIO_DB=/var/db/convento/disagio.db \
#     /usr/local/bin/python3.11 /opt/irc-games/disagio_api.py import-storico'
. /etc/rc.subr
name="disagio_api"
rcvar="disagio_api_enable"
load_rc_config "$name"
: ${disagio_api_enable:="NO"}
: ${disagio_api_db:="/var/db/convento/disagio.db"}
: ${disagio_api_bind:="10.66.6.7:8095"}
pidfile="/var/run/convento/disagio_api.pid"
procname="/usr/local/bin/python3.11"
command="/usr/sbin/daemon"
daemon_pidfile="${pidfile%.pid}.daemon.pid"
command_args="-f -R 5 -P ${daemon_pidfile} -p ${pidfile} -u convento -o /var/log/convento/disagio_api.log -t disagio-api \
  /usr/bin/env DISAGIO_DB=${disagio_api_db} \
  DISAGIO_BIND=${disagio_api_bind} \
  /usr/local/bin/python3.11 -u /opt/irc-games/disagio_api.py serve"
# Stesso mietitore degli altri sidecar: daemon(8) fa da supervisore e rc.subr
# insegue il FIGLIO (procname), quindi uno stop che trova il python gia' morto
# lascia vivo il supervisore col suo pidfile e lo start dopo muore con
# «process already running». Vedi ambrogio_next per la storia (2026-09-11).
start_precmd="convento_reap_supervisor"
stop_postcmd="convento_reap_supervisor"
convento_reap_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	rm -f "${daemon_pidfile}"; return 0 ;;
	esac
	if kill -0 "${_dpid}" 2>/dev/null; then
		if [ -r "${pidfile}" ] && kill -0 "$(cat ${pidfile} 2>/dev/null)" 2>/dev/null; then
			return 0
		fi
		kill -TERM "${_dpid}" 2>/dev/null
		sleep 1
		kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	fi
	rm -f "${daemon_pidfile}" "${pidfile}"
}

# Con -R il supervisore rigenera il figlio dopo 5s, quindi uno stop che
# ammazza solo il python non ferma niente: il supervisore muore PRIMA
# (daemon(8) inoltra il TERM al figlio e se ne va), e rc.subr trova il
# campo gia sgombro. Ordine di vjt 2026-09-19: "rendilo resilient convento".
stop_precmd="convento_kill_supervisor"
convento_kill_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	return 0 ;;
	esac
	kill -TERM "${_dpid}" 2>/dev/null
	sleep 2
	kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	return 0
}

run_rc_command "$1"
