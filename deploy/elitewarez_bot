#!/bin/sh
# PROVIDE: elitewarez_bot
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# EliteWarez su Azzurra. Quarto processo dello stesso bot.py nella jail di
# Convento — ordine di vjt (#sbiffo 2026-09-10 22:13): «poi spostiamo il !list
# gag. nella stessa jail di suore e mikebongiorno. vhost ...
# ti.prendo.per.il.culo.diostronzo.org», nick EliteWarez (22:16, verificato non
# SQLINEato con una connessione usa-e-getta prima di sceglierlo).
#
# IRC_BIND come per MikeBongiorno: su Azzurra il vhost e' l'rDNS dell'indirizzo
# da cui esci, quindi ogni bot della jail vuole il suo. fffc::e117 ha il PTR
# ti.prendo.per.il.culo.diostronzo.org (AAAA su Cloudflare, zona diostronzo.org;
# PTR via `netcup rdns ipv6 set`).
#
# Log e FIFO sono suoi: il gag tailla il log del bot che lo ospita e risponde
# sulla FIFO da cui e' arrivato il `!list`. Condividerli con Convento o Mike
# vorrebbe dire far parlare il listino con la bocca di un altro.
. /etc/rc.subr
name="elitewarez_bot"
rcvar="elitewarez_bot_enable"
load_rc_config "$name"
: ${elitewarez_bot_enable:="NO"}
pidfile="/var/run/convento/warez.pid"
# daemon(8) scrive nel pidfile il pid del FIGLIO: senza procname sull'interprete
# `status` dice «is not running» col bot vivo e `stop` non ammazza niente.
procname="/usr/local/bin/python3.11"
command="/usr/sbin/daemon"
daemon_pidfile="${pidfile%.pid}.daemon.pid"
command_args="-f -R 5 -P ${daemon_pidfile} -p ${pidfile} -u convento -o /var/log/convento/warez.stdout.log -t elitewarez \
  /usr/bin/env IRC_BIND=2a03:4000:20:2d3:fffc::e117 IRC_HOST=irc.azzurra.chat \
  IRC_NICK=EliteWarez IRC_IDENT=warez IRC_REAL='0-day warez dal 1996' \
  BOT_LOG=/var/log/convento/warez.log BOT_FIFO=/var/run/convento/warez.send \
  BOT_TRUST=/opt/convento/bot.trust.list BOT_ENV=/opt/convento/.env.list \
  BOT_STARTUP=/opt/convento/bot.startup.list \
  /usr/local/bin/python3.11 -u /opt/convento/bot.py"
# daemon(8) fa da supervisore e rc.subr insegue il FIGLIO (procname), quindi uno
# stop che trova il python gia' morto lascia vivo il supervisore col suo pidfile:
# lo start dopo muore con «process already running» e il sidecar resta giu' in
# silenzio (visto su convento_suore, 2026-09-11 23:33). -P da' al supervisore un
# pidfile suo, e l'hook qui sotto lo miete sia dopo stop che prima di start.
start_precmd="convento_reap_supervisor"
stop_postcmd="convento_reap_supervisor"
convento_reap_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	rm -f "${daemon_pidfile}"; return 0 ;;
	esac
	if kill -0 "${_dpid}" 2>/dev/null; then
		# figlio vivo = supervisore sano: giu' le mani, ci pensa rc.subr a
		# dire «already running».
		if [ -r "${pidfile}" ] && kill -0 "$(cat ${pidfile} 2>/dev/null)" 2>/dev/null; then
			return 0
		fi
		kill -TERM "${_dpid}" 2>/dev/null
		sleep 1
		kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	fi
	rm -f "${daemon_pidfile}" "${pidfile}"
}

# Con -R il supervisore rigenera il figlio dopo 5s, quindi uno stop che
# ammazza solo il python non ferma niente: il supervisore muore PRIMA
# (daemon(8) inoltra il TERM al figlio e se ne va), e rc.subr trova il
# campo gia sgombro. Ordine di vjt 2026-09-19: "rendilo resilient convento".
stop_precmd="convento_kill_supervisor"
convento_kill_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	return 0 ;;
	esac
	kill -TERM "${_dpid}" 2>/dev/null
	sleep 2
	kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	return 0
}

run_rc_command "$1"
