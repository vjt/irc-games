#!/bin/sh
# PROVIDE: mikebongiorno_bot
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# MikeBongiorno su Azzurra. Terzo processo dello stesso bot.py, nella stessa
# jail di Convento — ordine di vjt (#sbiffo 2026-09-09 23:36-23:47): «il sidecar
# lo fai diventare un bot a se stante», «il nome del bot trivial e'
# MikeBongiorno», «su m42 metti tutto nella stessa jail».
#
# IRC_BIND e' il punto di tutto il giro: su Azzurra il vhost e' l'rDNS
# dell'indirizzo da cui arrivi, quindi due bot nella stessa jail con due vhost
# diversi vogliono due indirizzi diversi, e senza source_address il kernel ne
# sceglie uno solo per entrambi. fffc::a11e ha il PTR
# ti.faccio.le.domande.mentre.sniffo.org (vjt, 23:37).
#
# Log e FIFO sono suoi: il gioco tailla il log del bot che lo ospita e risponde
# sulla FIFO da cui e' arrivato il comando. Condividerli con Convento vorrebbe
# dire far rispondere il quiz sulla bocca dello sparasuore.
#
# Trust vuoto e .env vuoto: nessun NickServ (il vhost non e' un grant dei
# servizi, e' DNS vero) e nessun ordine da nessuno — sulla sua FIFO scrive solo
# il quiz.
. /etc/rc.subr
name="mikebongiorno_bot"
rcvar="mikebongiorno_bot_enable"
load_rc_config "$name"
: ${mikebongiorno_bot_enable:="NO"}
pidfile="/var/run/convento/mike.pid"
# daemon(8) scrive nel pidfile il pid del FIGLIO: senza procname sull'interprete
# `status` dice «is not running» col bot vivo e `stop` non ammazza niente.
procname="/usr/local/bin/python3.11"
command="/usr/sbin/daemon"
daemon_pidfile="${pidfile%.pid}.daemon.pid"
command_args="-f -R 5 -P ${daemon_pidfile} -p ${pidfile} -u convento -o /var/log/convento/mike.stdout.log -t mikebongiorno \
  /usr/bin/env IRC_BIND=2a03:4000:20:2d3:fffc::a11e IRC_HOST=irc.azzurra.chat \
  IRC_NICK=MikeBongiorno IRC_IDENT=mike IRC_REAL='Allegria!' \
  BOT_LOG=/var/log/convento/mike.log BOT_FIFO=/var/run/convento/mike.send \
  BOT_TRUST=/opt/convento/bot.trust.mike BOT_ENV=/opt/convento/.env.mike \
  BOT_STARTUP=/opt/convento/bot.startup.mike BOT_DM_REJECT= \
  /usr/local/bin/python3.11 -u /opt/convento/bot.py"
# daemon(8) fa da supervisore e rc.subr insegue il FIGLIO (procname), quindi uno
# stop che trova il python gia' morto lascia vivo il supervisore col suo pidfile:
# lo start dopo muore con «process already running» e il sidecar resta giu' in
# silenzio (visto su convento_suore, 2026-09-11 23:33). -P da' al supervisore un
# pidfile suo, e l'hook qui sotto lo miete sia dopo stop che prima di start.
start_precmd="convento_reap_supervisor"
stop_postcmd="convento_reap_supervisor"
convento_reap_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	rm -f "${daemon_pidfile}"; return 0 ;;
	esac
	if kill -0 "${_dpid}" 2>/dev/null; then
		# figlio vivo = supervisore sano: giu' le mani, ci pensa rc.subr a
		# dire «already running».
		if [ -r "${pidfile}" ] && kill -0 "$(cat ${pidfile} 2>/dev/null)" 2>/dev/null; then
			return 0
		fi
		kill -TERM "${_dpid}" 2>/dev/null
		sleep 1
		kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	fi
	rm -f "${daemon_pidfile}" "${pidfile}"
}

# Con -R il supervisore rigenera il figlio dopo 5s, quindi uno stop che
# ammazza solo il python non ferma niente: il supervisore muore PRIMA
# (daemon(8) inoltra il TERM al figlio e se ne va), e rc.subr trova il
# campo gia sgombro. Ordine di vjt 2026-09-19: "rendilo resilient convento".
stop_precmd="convento_kill_supervisor"
convento_kill_supervisor()
{
	[ -r "${daemon_pidfile}" ] || return 0
	_dpid=$(cat "${daemon_pidfile}" 2>/dev/null)
	case "${_dpid}" in
	''|*[!0-9]*)	return 0 ;;
	esac
	kill -TERM "${_dpid}" 2>/dev/null
	sleep 2
	kill -0 "${_dpid}" 2>/dev/null && kill -KILL "${_dpid}" 2>/dev/null
	return 0
}

run_rc_command "$1"
